NODE_ENV=development
PORT=4000
# Local dev: run `npx prisma dev -d -n ami` in apps/api, then use the TCP URL it
# prints (it is a real Postgres server, so enums and arrays work).
# `pgbouncer=true` disables prepared statements, which the local Prisma Dev
# proxy does not support across reconnects.
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/ami?sslmode=disable&pgbouncer=true
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
SHOP_TIMEZONE=Asia/Manila
SHOP_PHONE=+639000000000
SHOP_MESSENGER_URL=https://m.me/ami-bread-and-coffee
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
OWNER_TOTP_ISSUER=Ami Bread and Coffee
RATE_LIMIT_REDIS_URL=
