# Optional. The backend address (no trailing /api).
# Defaults: http://localhost:5000 when developing,
#           https://ami-bread-and-coffee-p2yn.vercel.app on Vercel.
# The browser always calls this website's /api; proxy.ts forwards it here.
BACKEND_URL=http://localhost:5000

# Same long random value as PROXY_SECRET in the backend project.
# Lets the backend rate-limit per visitor. Optional locally.
PROXY_SECRET=
