# Where the Express backend runs (no trailing /api).
# The website forwards /api/* to it (see proxy.ts), so the browser never calls
# the backend directly and login cookies stay first-party.
#   Local:  http://localhost:5000
#   Vercel: https://<your-backend-project>.vercel.app
BACKEND_URL=http://localhost:5000

# Same long random value as PROXY_SECRET in the backend project. Optional locally.
PROXY_SECRET=

# Leave unset. Only set it to make the browser call an API directly.
# NEXT_PUBLIC_API_URL=
